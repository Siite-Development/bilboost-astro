---
/**
 * The list of cars. The SITE supplies the card as a slot function; this
 * component wraps each card in an `<li data-bb="card" …>` carrying the
 * attributes the live filter reads, so filtering works whatever the card
 * looks like.
 *
 *   <BbVehicleList vehicles={page.items} all={vehicles} pageSize={24}>
 *     <fragment slot="card">{(v, ctx) => <BilKort vehicle={v} ctx={ctx} />}</fragment>
 *   </BbVehicleList>
 *
 * `all` (every car, not just this page) enables live filtering: the whole
 * list is rendered with cards past the page size hidden, and the client
 * shows more on demand. Omit it for pure server-side paging.
 */
import type { PublicVehicle } from "../src/contract.ts";
import { canonicalPath } from "../src/slug.ts";

interface Props {
  vehicles: PublicVehicle[];
  all?: PublicVehicle[];
  basePath: string;
  pageSize?: number;
  moreLabel?: string;
  moreClass?: string;
  class?: string;
  listClass?: string;
}
const { vehicles, all, basePath, pageSize = 24, moreLabel = "Vis flere", moreClass = "", class: className, listClass } = Astro.props;

export type CardContext = { href: string; index: number; eager: boolean };

const rows = all ?? vehicles;
const visible = new Set(vehicles.map((v) => v.id));
const cards = await Promise.all(
  rows.map(async (v, index) => ({
    v,
    hidden: all ? !visible.has(v.id) : false,
    html: await Astro.slots.render("card", [v, { href: canonicalPath(basePath, v), index, eager: index < 2 } satisfies CardContext]),
  })),
);
---

<ul
  data-bb="list"
  data-bb-all={all ? "1" : "0"}
  data-bb-page-size={pageSize}
  data-bb-more-label={moreLabel}
  data-bb-more-class={moreClass}
  class:list={[className, listClass]}
>
  {cards.map(({ v, hidden, html }) => (
    <li
      data-bb="card"
      data-bb-id={v.id}
      data-bb-make={v.make}
      data-bb-model={v.model}
      data-bb-fuel={v.fuel_type ?? ""}
      data-bb-price={v.price ?? ""}
      data-bb-year={v.year ?? ""}
      data-bb-km={v.mileage ?? ""}
      data-bb-status={v.status}
      data-bb-created={v.created_at}
      data-bb-search={[v.id, v.make, v.model, v.variant, v.color, v.fuel_type, v.year].filter(Boolean).join(" ")}
      hidden={hidden}
      set:html={html}
    />
  ))}
</ul>
