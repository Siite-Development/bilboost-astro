---
/**
 * The price, formatted the Danish way, or "Pris efter aftale". Delivery
 * costs are a separate line by Danish convention; `showDelivery` adds it.
 */
import type { PublicVehicle } from "../src/contract.ts";
import { formatDKK, formatPrice } from "../src/format.ts";

interface Props {
  vehicle: Pick<PublicVehicle, "price" | "delivery_cost">;
  showDelivery?: boolean;
  deliveryLabel?: string;
  class?: string;
}
const { vehicle, showDelivery = false, deliveryLabel = "Leveringsomkostninger", class: className } = Astro.props;
---

<span data-bb="price" data-bb-has-price={vehicle.price !== null && vehicle.price > 0 ? "1" : "0"} class={className}>
  <span data-bb="price-amount">{formatPrice(vehicle.price)}</span>
  {showDelivery && vehicle.delivery_cost !== null && (
    <span data-bb="price-delivery">{deliveryLabel}: {formatDKK(vehicle.delivery_cost)}</span>
  )}
</span>
